# NightJar Environment Configuration
# Copy this file to .env and fill in your API keys
# LiteLLM is used as the universal provider layer — set keys for whichever
# providers you want to use. At least one provider key is required.

# ─── OpenAI ────────────────────────────────────────────────────────────
# Docs: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Google Gemini ─────────────────────────────────────────────────────
# Docs: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Groq (ultra-fast inference) ───────────────────────────────────────
# Docs: https://console.groq.com/keys
GROQ_API_KEY=

# ─── xAI (Grok) ────────────────────────────────────────────────────────
# Docs: https://console.x.ai/
XAI_API_KEY=

# ─── Mistral AI ────────────────────────────────────────────────────────
# Docs: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# ─── Cohere ────────────────────────────────────────────────────────────
# Docs: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ─── Anthropic (Claude) ────────────────────────────────────────────────
# Docs: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Ollama (local models) ─────────────────────────────────────────────
# Set to your Ollama server URL. Default: http://localhost:11434
# Use models like: ollama/llama3, ollama/mistral, etc.
OLLAMA_BASE_URL=http://localhost:11434

# ─── Default Model Tiers ───────────────────────────────────────────────
# Model used for simple/cheap routing tier. Supports provider-prefixed names.
# Examples: gpt-3.5-turbo, groq/llama3-8b-8192, gemini/gemini-1.5-flash
SIMPLE_MODEL=gpt-3.5-turbo

# Model used for complex/capable routing tier.
# Examples: gpt-4o, anthropic/claude-3-5-sonnet-20241022, gemini/gemini-1.5-pro
COMPLEX_MODEL=gpt-4o

# ─── Upstream reliability ──────────────────────────────────────────────
# Seconds to wait for a provider (LiteLLM's own default is 6000).
UPSTREAM_TIMEOUT_SECONDS=60
# Retries for rate-limit/timeout/5xx. Auth and bad-request errors are never retried.
UPSTREAM_RETRIES=2
# How long a deployment is skipped after repeated server-side failures (circuit breaker).
UPSTREAM_COOLDOWN_SECONDS=10
# Provider calls allowed at once; beyond this the gateway answers 503 + Retry-After.
MAX_CONCURRENT_UPSTREAM=128

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Redis holds cached response payloads. With a password: redis://:password@host:6379

# ─── Semantic Cache ────────────────────────────────────────────────────
# Exact-match caching is always on. The semantic tier is OFF by default: embedding similarity can
# return a wrong answer (docs/benchmarks/CACHE_CORRECTNESS.md). Turn on only if you accept that.
SEMANTIC_CACHE=false
SIMILARITY_THRESHOLD=0.92          # used only when SEMANTIC_CACHE=true
CACHE_MAX_TEMPERATURE=1.0          # requests above this are never cached (unset counts as 1.0)
CACHE_MAX_ENTRIES=50000
VECTOR_INDEX_PATH=./data/vectors.npz
CACHE_TTL_SECONDS=86400

# ─── Context Compression ───────────────────────────────────────────────
# Compression kicks in when BOTH conditions are met:
#   1. The total token count of the conversation exceeds this threshold.
#   2. The conversation has more than COMPRESSION_MIN_TURNS non-system messages.
# Increase this value to compress less aggressively (e.g. 4000 for GPT-4).
COMPRESS_THRESHOLD=2000

# Minimum number of non-system messages before compression is considered.
# Prevents summarising very short conversations where context loss is harmful.
COMPRESS_MIN_TURNS=6

# How many of the most-recent non-system turns to keep verbatim (not summarised).
# The compressor always keeps the system message + these recent turns untouched.
COMPRESS_KEEP_RECENT=4

# Fast, cheap model used to generate the conversation summary.
# Groq's llama3-8b is a good free alternative: groq/llama3-8b-8192
COMPRESS_SUMMARY_MODEL=gpt-3.5-turbo

# ─── Model Routing ─────────────────────────────────────────────────────
PREFERRED_PROVIDER=openai

# explicit (default): the model in the request is used as-is; routing happens only for the
# model alias "nightjar/auto" or the X-NightJar-Model-Override header.
# always: route every request by complexity (pre-2.0 behaviour).  off: never switch models.
ROUTING_MODE=explicit
# Comma-separated allow-list of models callers may request or override to. Empty = any.
ALLOWED_MODELS=

# ─── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Storage Paths ─────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/telemetry.db
# Delete telemetry older than N days at startup. 0 = keep everything (default; pruning is opt-in).
TELEMETRY_RETENTION_DAYS=0


# ─── Adaptive Threshold ────────────────────────────────────────────────

# ─── Test Mode (forces cheapest model for all requests) ────────────────
TEST_MODE=false

# ─── OpenTelemetry (Phase 3) ───────────────────────────────────────────
# Set ENABLE_OTEL=true and point to your OTLP collector (e.g. Jaeger, Grafana).
# The OTel SDK is always installed; tracing is a no-op when this is false.
ENABLE_OTEL=false
OTEL_ENDPOINT=http://localhost:4317

# ─── Gateway Authentication ─────────────────────────────────────────────
# Comma-separated bearer tokens required on protected endpoints
# (/v1/chat/completions, /v1/telemetry*, /v1/threshold*, /v1/cache*, /admin/*).
# NOT the same as the provider keys above — this authenticates callers to
# NightJar, not NightJar to the LLM providers.
# Leave blank (default) to keep auth disabled for local single-user dev.
# Required before exposing this gateway beyond localhost.
NIGHTJAR_API_KEYS=
# auto (default for local runs): enforce auth once any key exists. required: always. off: never.
# Leave this UNSET for Docker: the image sets required, and a line here would override it.
# Prefer scoped, hashed keys:  uv run python -m app.keys create --name app --scopes chat --rpm 60
# NIGHTJAR_AUTH=auto
DEFAULT_RATE_LIMIT_RPM=0

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated allowed origins, or "*" for any origin (default).
# Credentialed (cookie) CORS is never enabled — this gateway is
# authenticated via bearer token, so wildcard origins carry no CSRF risk.
CORS_ALLOW_ORIGINS=